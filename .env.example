APP_NAME=Restikey
APP_ENV=local
APP_KEY=
# Production: APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: LOG_LEVEL=error
LOG_LEVEL=debug

# Wajib MySQL/MariaDB dengan engine InnoDB (penguncian baris untuk mencegah double booking)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restikey
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Foto paket & portofolio di disk public (php artisan storage:link). Bukti transfer selalu di disk privat.
FILESYSTEM_DISK=public
# Email dikirim lewat antrean: jalankan "php artisan queue:work"
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Email
# Development: email ditulis ke storage/logs/laravel.log (MAIL_MAILER=log).
# Untuk melihat tampilan email, pakai Mailtrap: ganti blok di bawah dengan
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<username dari Mailtrap>
#   MAIL_PASSWORD=<password dari Mailtrap>
# Production: isi dengan SMTP penyedia email Anda.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@restikey.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Aturan bisnis Restikey (dibaca lewat config/restikey.php)
# ---------------------------------------------------------------------------
# Rekening tujuan transfer yang ditampilkan ke customer & di email
RESTIKEY_BANK_NAME=BCA
RESTIKEY_BANK_ACCOUNT_NUMBER=1234567890
RESTIKEY_BANK_ACCOUNT_NAME="PT Restikey Wedding Organizer"
# DP minimal (persen dari total harga)
RESTIKEY_DP_PERCENTAGE=30
# Tanggal acara paling cepat H+N dari hari booking
RESTIKEY_MIN_BOOKING_DAYS=30
# Pelunasan paling lambat H-N sebelum acara
RESTIKEY_PAYMENT_DEADLINE_DAYS=7
# Booking confirmed dibatalkan otomatis jika DP belum terverifikasi N hari setelah konfirmasi
RESTIKEY_AUTO_CANCEL_DAYS=3
# Jumlah maksimal per add-on dalam satu booking
RESTIKEY_MAX_ADDON_QUANTITY=10
# Kalender cek tanggal bisa dilihat sampai N bulan ke depan
RESTIKEY_CALENDAR_MONTHS_AHEAD=24
